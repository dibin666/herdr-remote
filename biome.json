{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/package-lock.json",
      "!**/test/fixtures/screens",
      "!**/public/fonts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noControlCharactersInRegex": "off",
        "noFocusedTests": "off",
        "noArrayIndexKey": "warn",
        "noAssignInExpressions": "warn",
        "useIterableCallbackReturn": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      },
      "a11y": {
        "noAutofocus": "warn",
        "noInteractiveElementToNoninteractiveRole": "warn",
        "noLabelWithoutControl": "warn",
        "noNoninteractiveTabindex": "warn",
        "noStaticElementInteractions": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useButtonType": "warn",
        "useKeyWithClickEvents": "warn",
        "useSemanticElements": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.*", "**/test/**", "**/tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noFocusedTests": "error"
          }
        }
      }
    },
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDuplicateProperties": "off",
            "noUnknownAtRules": {
              "level": "error",
              "options": {
                "ignore": ["tailwind"]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/**",
        "scripts/**",
        "!**/tests/**",
        "!**/test/**",
        "!**/*.test.*",
        "!**/i18n/en.*",
        "!**/i18n/zh.*"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": {
                "maxLines": 500
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/relay/src/relay-server.js",
        "packages/relay/web/src/components/TerminalView.tsx",
        "packages/relay/web/src/components/tui/index.tsx",
        "packages/cli/src/terminal-font.js",
        "packages/relay/web/src/context/TerminalContext.tsx",
        "packages/relay/web/src/render/HerdrRenderer.ts",
        "packages/cli/src/host-connector.js",
        "packages/relay/web/src/utils/predictiveEcho.ts",
        "packages/relay/web/src/components/SettingsModal.tsx",
        "packages/relay/web/src/render/customGlyphs.ts",
        "packages/relay/web/src/utils/touchMouseAdapter.ts",
        "packages/relay/web/src/protocol/clientAdapter.ts",
        "packages/relay/web/src/components/admin/AdminDashboard.tsx",
        "packages/relay/web/src/utils/storage.ts",
        "packages/relay/web/src/i18n/types.ts",
        "packages/relay/web/src/components/KeyToolbar.tsx",
        "packages/relay/web/src/utils/agentKeymaps.ts",
        "packages/relay/web/src/utils/terminalSelection.ts",
        "packages/relay/web/src/utils/useHostFont.ts",
        "scripts/capture-herdr-screens.mjs",
        "packages/cli/src/service.js",
        "packages/relay/web/src/utils/inputField.ts",
        "packages/cli/src/config.js",
        "scripts/e2e-latency-harness.mjs",
        "packages/relay/web/src/utils/virtualKeys.ts",
        "packages/cli/src/keepalive.js"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    }
  ]
}
