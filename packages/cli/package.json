{
  "name": "herdr-remote",
  "version": "0.2.18",
  "description": "Browser access to Herdr workspaces: plugin, host connector, and configuration TUI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dibin666/herdr-remote.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/dibin666/herdr-remote#readme",
  "bugs": {
    "url": "https://github.com/dibin666/herdr-remote/issues"
  },
  "keywords": [
    "herdr",
    "herdr-plugin",
    "terminal",
    "remote",
    "tui",
    "mobile"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "herdr-remote": "./bin/herdr-remote.js"
  },
  "main": "./src/service.js",
  "files": [
    "bin",
    "dist",
    "src",
    "herdr-plugin.toml",
    "config.example.json",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "node scripts/build-tui.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node bin/herdr-remote.js"
  },
  "dependencies": {
    "harfbuzzjs": "^1.6.2",
    "herdr-remote-relay": "^0.3.9",
    "ink": "^7.1.1",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "esbuild": "^0.25.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "~5.7.3",
    "vitest": "^3.2.7"
  }
}
