{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{js,mjs}"],
      "ignoreDependencies": ["node-pty", "ws", "esbuild", "@xterm/*"],
      "ignoreBinaries": ["herdr"]
    },
    "packages/cli": {
      "entry": [
        "bin/*.js",
        "src/host-connector-main.js",
        "scripts/*.mjs",
        "tui/src/index.tsx",
        "tests/**/*.test.js"
      ],
      "project": [
        "bin/**/*.js",
        "src/**/*.js",
        "tui/src/**/*.{ts,tsx}",
        "scripts/**/*.mjs",
        "tests/**/*.js"
      ],
      "ignoreBinaries": ["loginctl", "fc-match"]
    },
    "packages/relay": {
      "entry": ["bin/*.js", "tests/**/*.test.js"],
      "project": ["bin/**/*.js", "src/**/*.js", "tests/**/*.js"]
    },
    "packages/relay/web": {
      "entry": ["src/main.tsx", "src/test/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@xterm/addon-canvas"]
    }
  }
}
