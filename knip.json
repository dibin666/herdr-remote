{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{js,mjs}"],
      "ignoreDependencies": ["node-pty", "ws", "esbuild", "@xterm/*"],
      "ignoreBinaries": ["herdr"]
    },
    "packages/cli": {
      "entry": ["bin/*.js", "src/connector/main.ts", "src/tui/index.tsx", "tests/**/*.test.js"],
      "project": ["bin/**/*.js", "src/**/*.{js,ts,tsx}", "tests/**/*.js"],
      "ignoreBinaries": ["loginctl", "fc-match"],
      "ignoreDependencies": ["harfbuzzjs"]
    },
    "packages/relay": {
      "entry": ["bin/*.js", "tests/**/*.test.js"],
      "project": ["bin/**/*.js", "src/**/*.js", "tests/**/*.js"]
    },
    "packages/relay/web": {
      "entry": ["src/main.tsx", "src/test/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/vendor/**"],
      "ignoreDependencies": ["@xterm/addon-canvas"]
    }
  }
}
