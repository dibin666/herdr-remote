{
  "name": "herdr-remote-monorepo",
  "version": "0.2.0",
  "description": "Monorepo for herdr-remote and herdr-remote-relay",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/relay",
    "packages/cli",
    "packages/relay/web"
  ],
  "scripts": {
    "build": "npm run build -w herdr-remote-relay && npm run build -w herdr-remote",
    "pretest": "npm run build:server -w herdr-remote-relay",
    "test": "vitest run",
    "typecheck": "npm run typecheck -w herdr-remote-relay && npm run typecheck -w herdr-remote-web && npm run typecheck -w herdr-remote",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "check": "biome ci . && npm run typecheck",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "knip": "^6.38.0",
    "vitest": "^3.2.7"
  }
}
