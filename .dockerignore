# Keep the build context small and deterministic. Anything the Dockerfile does
# not explicitly COPY is still worth excluding: the context is uploaded to the
# builder in full before the first instruction runs.

.git/
.github/
.agents/
.android/
node_modules/
**/node_modules/

# Build output is produced inside the image, never copied from the host.
packages/cli/dist/
packages/relay/web/dist/
**/*.tsbuildinfo

# Tests and docs are not part of the runtime image. Web tests sit next to the
# source they cover, and the web build type-checks everything it is given, so
# they must go together with the src/test/ setup they depend on.
docs/
**/tests/
**/src/test/
**/*.test.ts
**/*.test.tsx

.env
.state/
*.log
*.tgz
*.md
